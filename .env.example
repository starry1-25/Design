# 复制为 .env 并填入你自己的 Agnes AI 密钥
# 密钥只放在 .env 里（该文件已被 .gitignore 排除），不要写进任何源码文件。

AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_IMAGE_MODEL_FALLBACK=agnes-image-2.1-flash
AGNES_MAX_TOKENS=4096

PORT=8230
BIND_ALL=false